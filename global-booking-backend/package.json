{
  "name": "global-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Foundation for the GLOBAL BOOKING multi-industry booking platform.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "bootstrap:admin": "tsx --env-file=.env src/scripts/bootstrap-super-admin.ts",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.6.1",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
