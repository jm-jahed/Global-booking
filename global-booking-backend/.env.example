# =============================================================================
# GLOBAL BOOKING — BACKEND CONFIGURATION EXAMPLE
# Copy this file to .env and configure privately with your real credentials.
# NEVER commit .env or real credentials to Git.
# =============================================================================

# Local HTTP server settings
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# MongoDB Atlas Database Connection
# Example format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=global_booking

# Security & Session Authentication
# In production, both keys must be distinct and at least 32 characters long.
JWT_SECRET=your_jwt_signing_secret_min_32_characters_here
COOKIE_SECRET=your_cookie_signing_secret_min_32_characters_here

# Frontend Client Origin (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Super Admin One-Time Bootstrap Configuration (Run via: npm run bootstrap:admin)
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
